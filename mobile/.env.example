# API base URL for the Django backend - see claude/ENV_GUIDE.md.
# Must be your machine's LAN IP address (e.g. http://192.168.1.X:8000/api/v1),
# NOT localhost - your phone/emulator is a separate device on the network and
# can't resolve "localhost" back to this machine. Find your IP with
# `ipconfig` (Windows) or `ifconfig`/`ip addr` (Mac/Linux).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.X:8000/api/v1
